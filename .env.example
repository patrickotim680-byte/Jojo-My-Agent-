# Copy this file to .env and fill in your own values. Never commit .env itself.
#
# ── Multi-provider fallback ─────────────────────────────────────────────
# JOJO tries providers in this order, skipping any without a key set, and
# automatically falls through to the next on quota/auth/network failure:
#   gemini → nvidia → puter (Claude) → openai
# Set as many or as few as you have — even one is enough to run. More = more
# resilience against any single one being down/rate-limited/broken.
# Reorder with PROVIDER_ORDER=gemini,nvidia,puter,openai (comma list).

# Gemini — free tier, no card needed: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash          # or gemini-2.5-flash-lite (fastest, weak-network friendly)

# NVIDIA NIM — free tier, no card needed: https://build.nvidia.com (open-weight models)
NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Puter — free, reaches real Claude, run `node scripts/get-puter-token.js` once to get this
PUTER_AUTH_TOKEN=
# PUTER_MODEL=claude-fable-5

# OpenAI — no meaningful free tier as of 2026, only useful once you've added billing
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# PROVIDER_ORDER=gemini,nvidia,puter,openai

# Optional — weak-network tuning. Retries transient failures automatically per
# provider before falling through to the next one.
# GEMINI_MAX_RETRIES=2
# GEMINI_RETRY_BASE_MS=800

# Optional — see README.md / WHATSAPP_CHANNEL.md / EMAIL_CHANNEL.md

# Optional — see CONTINUITY.md (cross-device continuity: daemon + push)
# JOJO_DEVICE_LABEL=work-laptop
# JOJO_CONTINUITY_STATE_FILE=./memory/continuity_state.json
# JOJO_CONTINUITY_PUSH_URL=
# JOJO_CONTINUITY_PUSH_HEADERS_JSON=
# JOJO_CONTINUITY_TICK_MS=30000
# JOJO_CONTINUITY_STALE_MS=180000
# JOJO_CONTINUITY_PUSH_DEBOUNCE_MS=900000

